    "ably": "^2.29.0",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.49.0",
    "maplibre-gl": "^5.24.0",
    "next": "16.3.8",
    "next-intl": "^4.14.8",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.30.0",
    "use-intl": "^4.14.8",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
